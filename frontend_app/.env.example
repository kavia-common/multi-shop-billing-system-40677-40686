# Environment example for the Multi-Shop Billing System (frontend)
# Copy to .env.local for local development.

# === Core API selection ===
# Base URL for the backend API. If empty, the app falls back to mock mode automatically.
# Required: No
# Example: https://api.example.com
NEXT_PUBLIC_API_BASE=

# Feature flags (space- or comma-separated).
# Supported flags:
# - mock_api: force the in-memory mock client (also used automatically when NEXT_PUBLIC_API_BASE is empty)
# Required: No
# Example: "mock_api"
NEXT_PUBLIC_FEATURE_FLAGS=

# === Runtime behavior ===
# Log level for client logger. One of: silent, error, warn, info, debug
# Required: No (defaults to debug in development, warn in test, info otherwise)
# Example: debug
NEXT_PUBLIC_LOG_LEVEL=info

# Exposed env for default log level heuristics (development|production|test)
# Required: No
# Example: development
NEXT_PUBLIC_NODE_ENV=development

# Toggle experimental UI/behaviors
# Required: No
# Example: true | false
NEXT_PUBLIC_EXPERIMENTS_ENABLED=false

# === URLs and deployment hints (not required by the runtime) ===
# Canonical backend URL (not used directly by the app)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Canonical frontend URL (not used directly by the app)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# WebSocket endpoint (not used by the app)
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Disable Next.js telemetry in some environments
NEXT_PUBLIC_NEXT_TELEMETRY_DISABLED=true

# Marker for enabling source maps in certain environments
NEXT_PUBLIC_ENABLE_SOURCE_MAPS=true

# Port hint for local environments (not used by Next directly)
NEXT_PUBLIC_PORT=3000

# Trust proxy hint (not used by this frontend at runtime)
NEXT_PUBLIC_TRUST_PROXY=false

# Container healthcheck path hint (not used by this frontend at runtime)
NEXT_PUBLIC_HEALTHCHECK_PATH=/healthz
